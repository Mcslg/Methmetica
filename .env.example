# ==========================================
# Methmetica 環境變數範本 (.env.example)
# ==========================================

# [選填] Google Gemini API Key
# 用於 AI 工作流自然語言生成與 DummyNode 子圖製造。
# 若本處未填寫，亦可在前端畫布的「AI 生成工作流」對話框中直接填入，系統會安全保存在瀏覽器 localStorage。
VITE_GEMINI_API_KEY=

# [選填] Supabase 認證與雲端儲存
# 用於 Google OAuth 登入、工作流雲端儲存與社群公開分享。
# 若未填寫，專案仍可正常啟動，本機畫布試算與 LocalStorage 草稿庫完全可用。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
